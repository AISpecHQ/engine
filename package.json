{
  "name": "@enginespec/engine",
  "version": "0.2.0",
  "description": "Universal local-first engine for versioning, integrity and provenance",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src/",
    "schemas/",
    "README.md",
    "LICENSE"
