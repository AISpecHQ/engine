{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aispec:schema:commit",
  "type": "object",
  "required": ["id", "parents", "branch", "author", "timestamp", "message", "snapshotIds"],
  "properties": {
    "id": {
      "$ref": "urn:aispec:schema:aispec#/$defs/id"
    },
    "parents": {
      "$ref": "urn:aispec:schema:aispec#/$defs/stringArray"
    },
    "branch": {
      "$ref": "urn:aispec:schema:aispec#/$defs/id"
    },
    "author": {
      "$ref": "urn:aispec:schema:aispec#/$defs/id"
    },
    "timestamp": {
      "$ref": "urn:aispec:schema:aispec#/$defs/utcTimestamp"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "snapshotIds": {
      "$ref": "urn:aispec:schema:aispec#/$defs/stringArray"
    },
    "tags": {
      "$ref": "urn:aispec:schema:aispec#/$defs/stringArray"
    },
    "metadata": {
      "$ref": "urn:aispec:schema:aispec#/$defs/metadata"
    }
  }
}
